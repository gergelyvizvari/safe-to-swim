# Server only. Copy to .env.local and fill in the selected Supabase project's values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Match this secret with safe_to_swim_cron_secret in Supabase Vault.
CRON_SECRET=
RESEND_API_KEY=

# Server only. A sender on your verified Resend domain (e.g. Safe to Swim <hello@your-domain.com>).
RESEND_FROM_EMAIL=
